---
import Card from '../layouts/Card.astro';
import { content } from '../content';
const c = content['zh-TW']!;
---
<Card current="home">
  <img src={c.avatar.src} alt={c.avatar.alt} width="96" height="96" onerror="this.hidden=true" />
  <h1>{c.name}</h1>
  <p>{c.tagline}</p>
  <p>{c.bio}</p>
  {[c.outputs, c.accounts].map(({ heading, items }) => (
    <section>
      <h2>{heading}</h2>
      <ul>
        {items.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.name}</a></li>
        ))}
      </ul>
    </section>
  ))}
</Card>
