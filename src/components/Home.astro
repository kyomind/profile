---
import Card from '../layouts/Card.astro';
import { content, type Locale } from '../content';
const { locale } = Astro.props as { locale: Locale };
const c = content[locale];
const tag = c.tagline.split(' × ');
---
<Card current="home" locale={locale} title={c.title}>
  <h1>{c.name}</h1>
  <p class="tagline"><span class="devops">{tag[0]}</span> <span class="x">×</span> {tag[1]} <span class="x">×</span> {tag[2]}</p>
  <div class="avatar"><img src={c.avatar.src} alt={c.avatar.alt} width="250" height="250" /></div>
  <p class="bio">{c.bio}</p>
  <div class="links">
    {[c.outputs, c.accounts].map(({ heading, items }, g) => (
      <section>
        <h2>{heading}</h2>
        <ul>
          {items.map((l) => (
            <li><a class={g === 0 ? 'btn primary' : 'btn'} href={l.href} target="_blank" rel="noopener noreferrer">{l.name}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Card>
