---
import Card from '../layouts/Card.astro';
import { content, type Locale } from '../content';
const { locale } = Astro.props as { locale: Locale };
const c = content[locale];
---
<Card current="projects" locale={locale} title={c.projects.title}>
  <h1>{c.projects.heading}</h1>
  {c.showcase.map((p) => (
    <section>
      <h2>{p.title}</h2>
      <p>{p.summary}</p>
      {p.highlights && <ul>{p.highlights.map((h) => <li>{h}</li>)}</ul>}
      <ul>
        {p.links.map((l) => (
          <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
        ))}
      </ul>
    </section>
  ))}
</Card>
