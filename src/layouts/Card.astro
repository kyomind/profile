---
import '../styles/site.css';
import { content, type Locale, type NavKey } from '../content';
// current 省略 = 非入口站頁面（404）：不標目前頁、不送 canonical／hreflang／og:url，加 noindex
interface Props { current?: NavKey; locale: Locale; title: string }
const { current, locale, title } = Astro.props;
const c = content[locale];
const origin = Astro.site!.origin;
const hrefOf = (l: Locale) => content[l].nav.links.find((x) => x.key === (current ?? 'home'))!.href;
---
<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={c.description} />
    {current ? (
      <>
        <link rel="canonical" href={origin + hrefOf(locale)} />
        <link rel="alternate" hreflang="zh-TW" href={origin + hrefOf('zh-TW')} />
        <link rel="alternate" hreflang="en" href={origin + hrefOf('en')} />
        <link rel="alternate" hreflang="x-default" href={origin + hrefOf('zh-TW')} />
      </>
    ) : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:locale" content={c.ogLocale} />
    {current && <meta property="og:url" content={origin + hrefOf(locale)} />}
    <meta property="og:image" content={c.avatar.src} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={c.description} />
    <meta name="twitter:image" content={c.avatar.src} />
    <script async src="https://umami.kyomind.tw/script.js" data-website-id="79cdd0f1-75b2-4ef7-b03f-dd14cc688099" data-domains="kyomind.tw"></script>
  </head>
  <body>
    <nav aria-label={c.nav.label}>
      {c.nav.links.map((l) => (
        <a href={l.href} aria-current={l.key === current ? 'page' : undefined}>{l.label}</a>
      ))}
      <span class="lang">
        {c.nav.langs.map((l) => <a href={hrefOf(l.locale)} hreflang={l.locale} lang={l.locale}>{l.label}</a>)}
      </span>
    </nav>
    <div class="card">
      <main class={current === 'home' ? 'home' : undefined}><slot /></main>
      <footer>© 2025-2026 Kyo Huang</footer>
    </div>
  </body>
</html>
